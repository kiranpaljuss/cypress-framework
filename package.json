{
  "name": "cypress-framework",
  "version": "1.0.0",
  "description": "Cypress + Cucumber (BDD) + TypeScript test automation framework covering UI and API testing, with parallel execution, HTML reporting and CI.",
  "author": "Kiranpal Juss",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/kiranpaljuss/cypress-framework.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "cy:open": "cypress open --e2e --browser chrome --env TAGS=\"${TAGS:-not @ignore}\"",
    "test": "yarn reports:clean && cypress run --browser chrome --env TAGS=\"${TAGS:-not @ignore}\"; code=$?; yarn report; exit $code",
    "test:smoke": "TAGS=@smoke yarn test",
    "test:ui": "TAGS=\"@ui and not @ignore\" yarn test",
    "test:api": "TAGS=\"@api and not @ignore\" yarn test",
    "test:parallel": "yarn reports:clean && tsx scripts/runFeaturesInParallel.ts; code=$?; yarn report; exit $code",
    "reports:clean": "rm -rf report cypress/screenshots && mkdir -p report/HTML report/JSON",
    "report": "tsx scripts/exportHTMLReport.ts",
    "lint": "eslint . && gherkin-lint",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "24.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "2.2.8",
    "@eslint/js": "9.38.0",
    "@stylistic/eslint-plugin": "6.0.1",
    "chalk": "6.0.1",
    "cucumber-html-reporter": "^7.2.0",
    "cypress": "15.17.0",
    "eslint": "9.38.0",
    "eslint-plugin-cypress": "6.4.1",
    "eslint-plugin-jsonc": "3.2.0",
    "gherkin-lint": "^4.2.4",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "jsonc-eslint-parser": "^3.1.0",
    "lint-staged": "17.0.7",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "typescript-eslint": "8.72.2"
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": "cypress/e2e/step_definitions/**/*.ts",
    "json": {
      "enabled": true,
      "output": "report/JSON/cucumber_report.json"
    },
    "filterSpec": true,
    "omitFiltered": true
  },
  "lint-staged": {
    "*.{ts,js,mjs,json}": [
      "eslint --fix"
    ],
    "*.feature": [
      "gherkin-lint"
    ]
  }
}
